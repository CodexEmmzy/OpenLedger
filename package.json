{
  "name": "openledger",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "api",
    "worker",
    "simulator"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "migrate": "node-pg-migrate up -m migrations --migration-file-language js",
    "migrate:down": "node-pg-migrate down -m migrations --migration-file-language js",
    "seed:accounts": "tsx scripts/seed-accounts.ts",
    "ledger:check": "tsx scripts/check-ledger-invariants.ts",
    "paystack:verify": "tsx scripts/verify-paystack-credentials.ts",
    "roles:verify": "tsx scripts/verify-db-roles.ts",
    "openapi:types": "openapi-typescript docs/openapi.yaml -o packages/shared/src/openapi.ts",
    "dev:api": "npm run dev -w @openledger/api",
    "dev:worker": "npm run dev -w @openledger/worker",
    "dev:simulator": "npm run dev -w @openledger/simulator"
  },
  "dependencies": {
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
